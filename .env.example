# Local PostgreSQL connection. On Render, use the database's Internal Database URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/inkpress?schema=public"

# Generate a long random secret; do not commit your real .env file.
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"
PORT=3000
NODE_ENV=development

# Used only by the first-run seed script. Change immediately after deployment.
ADMIN_NAME="Inkpress Admin"
ADMIN_EMAIL="admin@inkpress.local"
ADMIN_PASSWORD="ChangeMe-Immediately-123!"
